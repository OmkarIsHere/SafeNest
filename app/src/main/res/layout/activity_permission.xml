<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.permission.PermissionActivity">

    <TextView
        android:id="@+id/txtPermission"
        style="@style/Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_large"
        android:layout_marginTop="@dimen/size_max_large"
        android:layout_marginEnd="@dimen/size_large"
        android:text="We need this permission for it to work"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="@dimen/size_small"
        app:cardCornerRadius="@dimen/size_medium"
        app:contentPadding="@dimen/size_medium"
        android:layout_marginStart="@dimen/size_large"
        android:layout_marginTop="@dimen/size_max_bigger"
        android:layout_marginEnd="@dimen/size_large"
        app:layout_constraintTop_toBottomOf="@id/txtPermission"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="@+id/txtLocation"
            app:layout_constraintTop_toBottomOf="@+id/txtLocation">

            <TextView
                android:id="@+id/txtLocation"
                style="@style/Regular.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Location"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtLocationDesc"
                style="@style/Regular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="0.8"
                android:text="Location data is used for in-app maps, places alert and function as a location with your nest"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtLocation" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtLocationDesc"
                app:layout_constraintTop_toBottomOf="@+id/txtLocation" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardActivity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="@dimen/size_small"
        app:cardCornerRadius="@dimen/size_medium"
        app:contentPadding="@dimen/size_medium"
        android:layout_marginStart="@dimen/size_large"
        android:layout_marginTop="@dimen/size_large"
        android:layout_marginEnd="@dimen/size_large"
        app:layout_constraintTop_toBottomOf="@id/cardLocation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="@+id/txtLocation"
            app:layout_constraintTop_toBottomOf="@+id/txtLocation">

            <TextView
                android:id="@+id/txtPhysicalActivity"
                style="@style/Regular.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Physical Activity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtActivityDesc"
                style="@style/Regular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="0.8"
                android:text="Monitor car travel, driver safety and accident detection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtPhysicalActivity" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPhysicalActivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtActivityDesc"
                app:layout_constraintTop_toBottomOf="@+id/txtPhysicalActivity" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

