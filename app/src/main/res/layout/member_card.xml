<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_margin="@dimen/size_medium"

    app:cardCornerRadius="@dimen/size_medium"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/size_small"
        android:paddingBottom="@dimen/size_small"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgUserIcon"
            android:layout_width="@dimen/size_large_button"
            android:layout_height="@dimen/size_large_button"
            android:layout_marginStart="@dimen/size_large"
            android:contentDescription="User Image"
            app:strokeWidth="@dimen/smallest_padding"
            app:shapeAppearanceOverlay="@style/circleImageView"
            android:padding="@dimen/size_small"
            android:src="@drawable/person"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtUserName"
            style="@style/Regular.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_medium"
            android:text="John Doe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtLastSeen"
            app:layout_constraintStart_toEndOf="@+id/imgUserIcon" />

        <TextView
            android:id="@+id/txtLastSeen"
            style="@style/Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Last Seen: "
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txtUserName"
            app:layout_constraintTop_toBottomOf="@+id/txtUserName" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>