<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/txtDialogTitle"
        style="@style/Medium.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_large"
        android:text=""
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDialogContent"
        style="@style/Regular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_large"
        android:layout_marginEnd="@dimen/size_large"
        android:layout_marginTop="@dimen/size_medium"
        android:layout_marginBottom="@dimen/size_large"
        android:text=""
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnNegative"
        app:layout_constraintTop_toBottomOf="@id/txtDialogTitle" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNegative"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="wrap_content"
        android:text="Cancel"
        android:background="@drawable/bg_negative_button"
        android:textColor="@color/custom_grey"
        android:textAppearance="@style/Regular.Button"
        android:layout_margin="@dimen/size_medium"
        app:layout_constraintTop_toBottomOf="@id/txtDialogContent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPositive"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPositive"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="wrap_content"
        android:text="Ok"
        android:background="@drawable/bg_positive_button_red"
        android:textColor="@color/white"
        android:textAppearance="@style/Regular.Button"
        android:layout_marginEnd="@dimen/size_medium"
        app:layout_constraintTop_toTopOf="@id/btnNegative"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnNegative" />

</androidx.constraintlayout.widget.ConstraintLayout>