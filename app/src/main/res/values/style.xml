<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Regular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="android:fontFamily">@font/sf_pro_regular</item>
        <item name="android:textSize">@dimen/size_standard_txt</item>
    </style>

    <style name="Medium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="android:fontFamily">@font/sf_pro_medium</item>
        <item name="android:textSize">@dimen/size_standard_large_txt</item>
    </style>

    <style name="Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/size_label_posts</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LogoStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/size_label_posts</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Regular.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Regular.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/size_standard_txt</item>
    </style>

    <style name="Medium.Bold">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Medium.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/size_standard_large_txt</item>
    </style>

    <style name="Subtitle.Button">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="textInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxStrokeColor">@color/light_grey</item>
        <item name="hintTextColor">@color/dark_grey</item>
        <item name="android:textColorHint">@color/light_grey</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="boxCornerRadiusTopStart">@dimen/size_border_curve</item>
        <item name="boxCornerRadiusTopEnd">@dimen/size_border_curve</item>
        <item name="boxCornerRadiusBottomStart">@dimen/size_border_curve</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/size_border_curve</item>
        <item name="boxStrokeWidth">@dimen/size_border</item>
    </style>

    <style name="textInputLayoutStyle.more_rounded">
        <item name="boxCornerRadiusTopStart">@dimen/size_max_bigger</item>
        <item name="boxCornerRadiusTopEnd">@dimen/size_max_bigger</item>
        <item name="boxCornerRadiusBottomStart">@dimen/size_max_bigger</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/size_max_bigger</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size_max_bigger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/rounded_corner_button</item>
        <item name="android:textSize">@dimen/size_standard_txt</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/size_little_max_large</item>
        <item name="android:paddingStart">@dimen/size_medium</item>
        <item name="android:paddingEnd">@dimen/size_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/size_standard_txt</item>
    </style>

    <style name="Widget.App.Button.Rounded" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">@dimen/size_rounded_button</item>
        <item name="android:layout_height">@dimen/size_rounded_button</item>
        <item name="android:padding">@dimen/size_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/Custom_grey_black</item>
        <item name="android:background">@drawable/bg_circle_yellow</item>
        <item name="android:textSize">@dimen/size_smaller_txt</item>
    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/light_blue</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>